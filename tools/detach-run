#!/usr/bin/env python3
"""detach-run —— 把长耗时命令真正甩到后台，不受本轮 claude 进程生死影响。

为什么需要它（这是踩过的坑，别删）：
claude-gateway 每条飞书消息 spawn 一个一次性 `claude -p` 子进程，本轮 result
一到进程就退出。Claude Code 自己的 `Bash(run_in_background=true)` 起的任务由该
进程托管，进程一退任务立刻被 SIGTERM —— 于是「已提交，70 秒后出片」永远等不到
结果，用户再问一次又重新提交一次，死循环卡在「处理中…」。

普通的 `nohup cmd &` 也不够：nohup 只挡 SIGHUP，挡不住发给整个进程组的 SIGTERM。
本工具用 start_new_session=True（等价 setsid，macOS 没有 setsid 命令）让子进程
自立门户成新会话/新进程组，父进程被杀跟它无关。

用法:
    detach-run [--name <标签>] [--log <路径>] -- <命令> [参数...]
    detach-run <命令> [参数...]                     # 省略 -- 亦可

输出（给模型看的，别改格式）:
    ✅ 已脱离后台运行
    PID: 12345
    LOG: /tmp/detach-run/<name>-<pid>.log
    查看: tail -50 <log>
    状态: kill -0 12345 && echo RUNNING || echo DONE
"""
import os
import subprocess
import sys
import time

LOG_DIR = os.path.expanduser("~/.claude-gateway/detached")


def _parse(argv: list[str]) -> tuple[str, str, list[str]]:
    name, log = "", ""
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--name" and i + 1 < len(argv):
            name = argv[i + 1]; i += 2
        elif a == "--log" and i + 1 < len(argv):
            log = argv[i + 1]; i += 2
        elif a == "--":
            i += 1; break
        elif a.startswith("--"):
            print(f"❌ 未知参数 {a}", file=sys.stderr); sys.exit(2)
        else:
            break
    return name, log, argv[i:]


def main() -> None:
    name, log, cmd = _parse(sys.argv[1:])
    if not cmd:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)

    if not name:
        name = os.path.basename(cmd[0]).replace(" ", "_")[:40] or "task"
    if not log:
        os.makedirs(LOG_DIR, exist_ok=True)
        log = os.path.join(LOG_DIR, f"{name}-{int(time.time())}.log")
    log = os.path.expanduser(log)
    os.makedirs(os.path.dirname(log) or ".", exist_ok=True)

    # 单个字符串且带 shell 元字符 → 交给 shell 跑（允许管道/重定向/&&）
    shell = len(cmd) == 1 and any(c in cmd[0] for c in "|&;<>$`(){}*?")
    with open(log, "ab", buffering=0) as f:
        f.write(f"$ {' '.join(cmd)}\n[detach-run] started {time.strftime('%F %T')}\n".encode())
        proc = subprocess.Popen(
            cmd[0] if shell else cmd,
            shell=shell,
            stdin=subprocess.DEVNULL,
            stdout=f,
            stderr=subprocess.STDOUT,
            start_new_session=True,      # ← 核心：脱离父进程的会话与进程组
            cwd=os.getcwd(),
            env=os.environ.copy(),
        )

    print("✅ 已脱离后台运行")
    print(f"PID: {proc.pid}")
    print(f"LOG: {log}")
    print(f"查看: tail -50 {log}")
    print(f"状态: kill -0 {proc.pid} 2>/dev/null && echo RUNNING || echo DONE")


if __name__ == "__main__":
    main()
