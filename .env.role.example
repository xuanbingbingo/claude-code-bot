# 多 bot「角色 bot」配置模板
# 用法：复制为 .env.<role>（如 .env.research），填入该 bot 专属的飞书凭证，
#       然后 `bash start-bot.sh <role>` 启动。.env.<role> 含密钥，已被 .gitignore 忽略，不入库。
#
# 💡 更省事：直接 `bash scripts/new-agent.sh <role>`（不传凭证）会弹二维码，手机飞书扫码
#    自动建应用并生成本文件，免去手动进开放平台建应用抄凭证。见 README「一键创建新角色 bot」。

# 该 bot 单独建的飞书自建应用的凭证
FEISHU_APP_ID=cli_your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here
FEISHU_VERIFY_TOKEN=

# 这个 bot 的 Claude 工作目录（按需改成你自己的路径）
CLAUDE_CWD=/path/to/your/workdir

# 人设来源（二选一，都不填则为通用无人设）：
#   BOT_PERSONA_FILE：指向一个角色 .md 文件，自动去掉 YAML frontmatter 作为人设
#   BOT_PERSONA：直接内联一段人设文本（优先级高于 FILE）
BOT_PERSONA_FILE=/path/to/your/agents/your-role.md
# BOT_PERSONA=你是一名……

# 可选：bot 名字（仅用于启动日志显示）
BOT_NAME=角色名

# ── 可选：bot 间协作（群里 bot 互相 @ 接力）──────────────────────
# BOT_RELAY=1 开启；被 @ 后 bot 可在回复末尾 @ 队友把子任务接力下去。
# 用「跳数上限」防死循环：人发起=0，每接力一跳 +1，到上限自动停止接力。
# BOT_TEAMMATES 填本群里队友的「飞书显示名」（逗号分隔），bot 只会 @ 这些名字。
BOT_RELAY=0
BOT_MAX_HOPS=5
BOT_TEAMMATES=队友A,队友B

# ── 可选：长任务超时 ────────────────────────────────────────────
# 静默看门狗是分级的：等 API 用短尺子(_STALL)，工具正在跑用长尺子(_TOOL_STALL)，
# 所以「Bash 跑视频渲染半天不吭声」不会再被当成流卡死砍掉，一般无需改这几项。
CLAUDE_RUN_TIMEOUT=1800         # 单条回复总上限(秒)，默认 1800
CLAUDE_STALL_TIMEOUT=180        # 等 API 时静默多久判流断(秒)，默认 180
CLAUDE_TOOL_STALL_TIMEOUT=900   # 工具执行中静默多久判卡死(秒)，默认 900

# ⚠️ 真正的长任务(生成视频/大批量渲染)不该在对话里干等：
# bot 已被强制注入运行时规则，会用 tools/detach-run 把它们甩到后台(脱离进程组，
# 本轮 claude 进程退出也照跑)，然后下一轮 tail 日志汇报。见 core/runtime_rules.py。
