# 企业微信「角色 bot」配置模板(对标 .env.role.example)
# 用法:复制为 .env.wecom-<role>(如 .env.wecom-research),填企微智能机器人凭证,
#       然后 `bash start-wecom.sh <role>` 启动。含密钥,已被 .gitignore 忽略。

# 企微智能机器人长连接凭证(管理后台/工作台→智能机器人→API模式→使用长连接 获取)
WECOM_BOT_ID=your_bot_id_here
WECOM_SECRET=your_secret_here
# 私有部署企业才需改;公有云默认即可
# WECOM_WS_URL=wss://openws.work.weixin.qq.com

# 这个 bot 的 Claude 工作目录
CLAUDE_CWD=/path/to/your/workdir

# 人设来源(与飞书同款,二选一;都不填=通用无人设)
BOT_PERSONA_FILE=/path/to/your/agents/your-role.md
# BOT_PERSONA=你是一名……
BOT_NAME=角色名

# bot 间协作(企微精确 @ 需 userid,当前为注入队友提示版,二期对齐名册)
BOT_RELAY=0
BOT_MAX_HOPS=5
BOT_TEAMMATES=quant-engineer:量化工程师,quant-lead:量化首席

# 流式安全时限(秒):企微流式硬超时 6min,到点降级为主动推送;默认 300
WECOM_STREAM_SAFE_SEC=300

# 长任务超时(跑回测/分析建议调大)
CLAUDE_RUN_TIMEOUT=1800
CLAUDE_STALL_TIMEOUT=600
