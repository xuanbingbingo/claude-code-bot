                              "cron_last_failed", "retired_port", "loaded_without_plist", "restart_script_drift"]},
        "rotate": {"args": ["[<role|label>]", "--max-mb N", "--keep N", "--tail N", "--force", "--dry-run",
                            "--json"], "readonly": False,
                   "note": "copytruncate：超过 max-mb 的日志压成 .1.gz（保留 keep 份，0=不留），原文件清空只留尾部 tail 行；"
                           "每天 03:17 由 launchd com.claude.gw-logrotate 自动跑"},
        "capabilities": {"args": ["--json"], "readonly": True},
