}


def cmd_capabilities(a):
    if a.json:
        emit_json({"ok": True, **CAPABILITIES})
    print(json.dumps(CAPABILITIES, ensure_ascii=False, indent=2))


def main():
    p = argparse.ArgumentParser(prog="gw", description="claude-gateway bot 运维（自动发现 .env + launchd）")
    p.add_argument("--version", action="version", version=f"gw {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("ls", help="列出所有 bot / 定时任务")
    s.add_argument("--json", action="store_true")
    s.add_argument("--no-cron", action="store_true", help="不列 bot-cron 定时任务")
    s.set_defaults(fn=cmd_ls)

    s = sub.add_parser("status", help="单个 bot 详情 + 近期错误摘要")
    s.add_argument("role")
    s.add_argument("--lines", type=int, default=400, help="扫描日志尾部行数（默认 400）")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("logs", help="看日志尾部")
    s.add_argument("role")
    s.add_argument("-n", type=int, default=50)
    s.add_argument("--err", action="store_true", help="只看错误行（+ launchd stderr 文件）")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_logs)

    s = sub.add_parser("restart", help="launchctl kickstart -k 重启")
    s.add_argument("role", nargs="?")
    s.add_argument("--all", action="store_true", help="重启自动发现的全部 bot")
    s.add_argument("--dry-run", action="store_true", help="只打印将执行的命令")
    s.add_argument("--wait", type=int, default=0, help="重启后等 N 秒复核进程是否起来")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_restart)

    s = sub.add_parser("doctor", help="体检：漂移 / 未加载 / 崩溃 / 退役端口等")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_doctor)

    s = sub.add_parser("rotate", help="日志轮转（copytruncate + gzip 归档）")
    s.add_argument("role", nargs="?", help="只轮转某个 bot；不给则全部")
    s.add_argument("--max-mb", type=float, default=ROTATE_MAX_MB, help=f"超过才轮转（默认 {ROTATE_MAX_MB}）")
    s.add_argument("--keep", type=int, default=ROTATE_KEEP, help=f"保留几份 .gz 归档，0=直接丢弃（默认 {ROTATE_KEEP}）")
    s.add_argument("--tail", type=int, default=ROTATE_TAIL_LINES, help=f"原文件保留最后几行（默认 {ROTATE_TAIL_LINES}）")
    s.add_argument("--force", action="store_true", help="不看大小，全部轮转")
    s.add_argument("--dry-run", action="store_true")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_rotate)

    s = sub.add_parser("capabilities", help="自描述")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_capabilities)

    a = p.parse_args()
    try:
        a.fn(a)
    except SystemExit:
        raise
    except Exception as e:  # noqa: BLE001
        fail(f"{type(e).__name__}: {e}", getattr(a, "json", False))


if __name__ == "__main__":
    main()
