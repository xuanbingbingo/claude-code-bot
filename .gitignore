.env
# 各 bot 的私有凭证（.env.feishu2/.env.feishu3/.env.<role> 等），绝不入库；只保留模板
.env.*
!.env.example
!.env.role.example
# 多 bot 运行日志
bot-*.log
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.DS_Store
claude-telegram.log
claude-feishu.log

# Python 虚拟环境(142MB,绝不入库)
venv/
.venv/

# 所有 log 文件
*.log

# 运行时文件
*.pid
# relay 名册缓存（运行时学到的 open_id 映射，本机数据不入库）
roster-cache.json
roster-cache.json.*.tmp

# 备份/临时文件
*.bak
*.bak-*

# bot 名册缓存(含 open_id,按 app 隔离,不入库)
.roster-*.json
